<Window x:Class="bsd.HistoryPage"
        xmlns:cae ="clr-namespace:FluidKit.Controls;assembly=FluidKit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        mc:Ignorable="d"
        Title="HistoryPage" Height="450" Width="800">
    <Grid>
        <DataGrid IsReadOnly="True" ItemsSource="{Binding history}"/>
    </Grid>
</Window>
