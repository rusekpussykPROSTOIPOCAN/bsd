<Window x:Class="bsd.AddBooksFromExcel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        xmlns:viewmodel="clr-namespace:bsd.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:BookDeliveryViewModel}"
        mc:Ignorable="d"
         WindowStartupLocation="CenterScreen"
 ResizeMode="NoResize"
        Title="AddBooksFromExcel" Height="123" Width="373">
    <Window.Resources>
        
        <Style TargetType="Button">
            
            <Setter Property="Width" Value="AUTO"/>

            <Setter Property="Margin" Value="5"/>

        </Style>
    </Window.Resources>
    <StackPanel VerticalAlignment="Center" >
        <TextBlock HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://aiglbkpynfwjrxmgonmy.supabase.co/storage/v1/object/public/exel//bps.xltx">Скачать шаблон</Hyperlink>
        </TextBlock>
        <Button Background="#4361EE"
 Foreground="White"
 BorderBrush="Transparent"
 FontSize="14"
 FontWeight="SemiBold"
 Height="30"
 Margin="5"
 Cursor="Hand" Content="Выбрать файл" Command="{Binding GetBooksFromExelCommand}"/>
    </StackPanel>
</Window>
