<Window x:Class="bsd.UserHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        mc:Ignorable="d"
        Title="UserHistory" Height="450" Width="800">
    <Grid>
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Hview}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Книга" Binding="{Binding BookName}"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Autor}"/>
                <DataGridTextColumn Header="Дата взятия" Binding="{Binding DateOfIssueOrBooking}"/>
                <DataGridTextColumn Header="Дата сдачи" Binding="{Binding dateOfDel}"/>
                <DataGridTextColumn Header="Предварительная дата сдачи" Binding="{Binding PrelimDateOfDel}"/>
                <DataGridTextColumn Header="Бронь или срок" Binding="{Binding BookingOrExtradition}"/>
                <DataGridTextColumn Header="Закрыта ли запись" Binding="{Binding End}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
