<Window x:Class="bsd.PageForUsers"
      xmlns:c1grid="clr-namespace:System.Formats.Asn1;assembly=System.Formats.Asn1"
        Background="OldLace"
        xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd" xmlns:c1grid1="http://schemas.componentone.com/wpf/C1DataGrid"
        mc:Ignorable="d"
        Title="PageForUsers" Height="450" Width="800">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="Carusel">
           
        </ItemsPanelTemplate>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Height" Value="500"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition ></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox Grid.ColumnSpan="2" Grid.Row="1"/>
        <Button Content="Поиск" Grid.Column="2" Grid.Row="1"/>
        <Button Click="Button_Click_1" VerticalAlignment="Bottom" Content="Выход" Grid.Column="0" Grid.Row="4"/>
        <Button Content="История" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Click="Button_Click"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <DataGrid ItemsSource="{Binding topbooks}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Title}"/>
                    <DataGridTextColumn Binding="{Binding Autor}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <ListView Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--Чето еще-->
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
