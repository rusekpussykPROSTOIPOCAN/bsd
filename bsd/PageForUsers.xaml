<Window x:Class="bsd.PageForUsers"
      xmlns:c1grid="clr-namespace:System.Formats.Asn1;assembly=System.Formats.Asn1"
        Background="OldLace"
        xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        xmlns:viewmodel="clr-namespace:bsd.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:BookDeliveryViewModel}"
        mc:Ignorable="d"
        Title="PageForUsers" Height="450" Width="800">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="Carusel">

        </ItemsPanelTemplate>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Height" Value="500"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto" ></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox x:Name="Search" Grid.Column="1" Grid.Row="1"/>
        <Label Content="Топ 50 книг за месяц" FontWeight="Bold" Background="Azure" HorizontalContentAlignment="Center"/>
        <Button Content="Поиск" Grid.Column="2" Grid.Row="1" Click="Button_Click_2"/>
        <Button Click="Button_Click_1" VerticalAlignment="Bottom" Content="Выход" Grid.Column="0" Grid.Row="5"/>
        <Button Content="История" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Click="Button_Click" Height="30" VerticalAlignment="Top"/>
        <ListBox Grid.Row="1" Grid.RowSpan="4" ItemsSource="{Binding topbooks}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Width="200" Margin="10">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Autor}" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4">

            <DataGrid ItemsSource="{Binding books}" IsReadOnly="True" CanUserSortColumns="True" AutoGenerateColumns="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Autor" Binding="{Binding Autor}"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}"/>
                    <DataGridTextColumn Header="Chapter" Binding="{Binding Chapter}"/>
                    <DataGridTextColumn Header="InventaryNum" Binding="{Binding InventaryNum}"/>
                    <DataGridTextColumn Header="Condition" Binding="{Binding condition}"/>
                    <DataGridTextColumn Header="CountBooking" Binding="{Binding CountBooking}"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</Window>
