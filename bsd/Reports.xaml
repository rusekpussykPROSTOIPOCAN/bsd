<Window x:Class="bsd.Reports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd" xmlns:local1="clr-namespace:bsd.ReportViews"
        mc:Ignorable="d"
        Title="Создание отчета" Height="450" Width="600">
    <Window.Resources>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
            <Setter Property="Width" Value="AUTO"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.RowSpan="3" Background="DarkGray"/>
        <ComboBox x:Name="FormComboBox" SelectionChanged="FormComboBox_SelectionChanged" Grid.Row="0" />
        <Button Content="Печать" Grid.Row="1"/>
        <Grid x:Name="SampleReport" Grid.Column="2" Grid.RowSpan="3">
            <local1:ReportForDay x:Name="Form1" Visibility="Collapsed"/>
            <local1:ReportForMonth x:Name="Form2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
