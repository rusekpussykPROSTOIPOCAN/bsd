<Window x:Class="bsd.Reports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd" xmlns:local1="clr-namespace:bsd.ReportViews"
        mc:Ignorable="d"
         WindowStartupLocation="CenterScreen"
        Title="Создание отчета" Height="450" Width="600">
    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                BlurRadius="20" 
                ShadowDepth="5" 
                Opacity="0.2"/>


        <Style  TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="MaxLength" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4361EE"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4361EE"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style TargetType="Label">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="AUTO"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.RowSpan="3" Background="LightGray"/>
        <ComboBox x:Name="FormComboBox" SelectionChanged="FormComboBox_SelectionChanged" Grid.Row="0" />
        <Button Click="Button_Click" Content="Печать" Grid.Row="1"/>
        <Grid x:Name="SampleReport" Grid.Column="2" Grid.RowSpan="3">
            <local1:ReportForDay x:Name="Form1" Visibility="Collapsed"/>
            <local1:ReportForMonth x:Name="Form2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
