<Window x:Class="bsd.AdminPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        mc:Ignorable="d"
        Title="AdminPage" Height="385" Width="285">
    <Window.Resources>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
            <Setter Property="Width" Value="AUTO"/>
          
            <Setter Property="Margin" Value="5"/>
            
        </Style>
    </Window.Resources>
    
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Button Click="Button_Click"  Grid.Row="0" Content="Добавить книгу"/>
        <Button Click="Button_Click_3"  Grid.Row="1" Content="Импортировать список книг из excel"/>
        <Button Click="Button_Click_2"  Grid.Row="2" Content="Удалить книгу"/>
        <Button Click="Button_Click_1"   Grid.Row="3" Content="Выйти"/>
    </Grid>
</Window>
