<Window x:Class="bsd.NewUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        mc:Ignorable="d"
        Title="NewUser" Height="450" Width="800">
    <Window.Resources>

        <Style TargetType="Label">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            
        </Style>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
            <Setter Property="Width" Value="AUTO"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="MaxLength" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MaxLength" Value="50"/>
            <Setter Property="MaxWidth" Value="200"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Имя"/>
        <TextBox x:Name="Name"  Grid.Row="0" Grid.Column="1"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Фамилия"/>
        <TextBox x:Name="LastName" Grid.Row="1" Grid.Column="1"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Пароль"/>
        <TextBox x:Name="Pass" Grid.Row="2" Grid.Column="1"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Почта"/>
        <TextBox x:Name="Email" Grid.Row="3" Grid.Column="1"/>
        <Label Grid.Row="4" Grid.Column="0" Content="Серия и номер"/>
        <TextBox x:Name="SerNum" Grid.Row="4" Grid.Column="1"/>
        <Label Grid.Row="5" Grid.Column="0" Content="Пол"/>
        <TextBox x:Name="Sex" Grid.Row="5" Grid.Column="1"/>
        <Label Grid.Row="6" Grid.Column="0" Content="Кем выдана"/>
        <TextBox x:Name="Whom" Grid.Row="6" Grid.Column="1"/>
        <Label Grid.Row="7" Grid.Column="0" Content="Дата выдачи"/>
        <TextBox x:Name="Code" Grid.Row="6" Grid.Column="1"/>
        <Label Grid.Row="7" Grid.Column="0" Content="Дата выдачи"/>
        <TextBox x:Name="DateV" Grid.Row="7" Grid.Column="1"/>
        <Button Margin="20" Grid.Row="8" Content="Создать" Grid.ColumnSpan="2" Width="200" Click="Button_Click"/>
    </Grid>
</Window>
