<Window x:Class="bsd.WorkSpaceForLibrarions"
        Background="AliceBlue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowStartupLocation="CenterScreen"

        mc:Ignorable="d"
        Title="WorkSpaceForLibrarions" Height="397" Width="594">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" 
                  BlurRadius="20" 
                  ShadowDepth="5" 
                  Opacity="0.2"/>


        <Style  TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="MaxLength" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4361EE"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4361EE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

       
        <Style TargetType="Label">
            <Setter Property="Background" Value="#4361EE"/>  
            <Setter Property="Foreground" Value="White"/>
        </Style>
       
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="AUTO"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
       
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"></ColumnDefinition>
            <ColumnDefinition Width="108*"/>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Button Content="Добавить читателя" Grid.Column="2" Grid.Row="0" Margin="6,5,5,5" Click="Button_Click_2" Height="20" VerticalAlignment="Bottom"/>
        <Button Name="BookDeliveryBtn" Click="BookDelivery_Click" Content="Выдача книги" Grid.Column="3" Grid.Row="0" Margin="5,5,6,5"/>
        <Button Content="Просмотр истории" Grid.Column="4" Grid.Row="0" Margin="4,5,5,5" Click="Button_Click_5"/>
        <Button Content="Сдача книги" Grid.Column="6" Grid.Row="0" Margin="4,5,5,5" Click="Button_Click_6"/>
        <ComboBox   Grid.Row="1"  Grid.Column="6" Margin="4,5,5,5">
            <Button Content="Строгий поиск"  Click="Button_Click_3"/>
            <Button Content="Поиск"  Click="Button_Click_4"/>
      </ComboBox>
        <TextBox  x:Name="Search"  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Margin="6,5,6,5"/>
        <Button Name="PageForReport" Click="PageForReport_Click" Content="Создать отчет" Grid.Column="5" />
        <StackPanel Background="WhiteSmoke" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2">
            
            <Button  VerticalAlignment="Center" Content="Выход" Click="Button_Click"/>

        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5">

  <DataGrid ItemsSource="{Binding books}" IsReadOnly="True" CanUserSortColumns="True" AutoGenerateColumns="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Autor" Binding="{Binding Autor}"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}"/>
                    <DataGridTextColumn Header="Chapter" Binding="{Binding Chapter}"/>
                    <DataGridTextColumn Header="InventaryNum" Binding="{Binding InventaryNum}"/>
                    <DataGridTextColumn Header="Condition" Binding="{Binding condition}"/>
                    <DataGridTextColumn Header="CountBooking" Binding="{Binding CountBooking}"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>


</Window>
