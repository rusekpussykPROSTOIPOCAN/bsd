<Window x:Class="bsd.WorkSpaceForLibrarions"
        Background="AliceBlue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bsd"
        mc:Ignorable="d"
        Title="WorkSpaceForLibrarions" Height="397" Width="594">
    <Window.Resources>

        <Style TargetType="Label">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="Brush">
            <GradientStop Offset="0" Color="LightCyan"/>
            <GradientStop Offset="0.5" Color="LightBlue"/>
            <GradientStop Offset="1" Color="LightCyan"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush}"/>
            <Setter Property="BorderBrush" Value="LightSeaGreen"/>
            <Setter Property="Width" Value="AUTO"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="20"/>
            <Setter Property="MaxLength" Value="40"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"></ColumnDefinition>
            <ColumnDefinition Width="108*"/>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
            <ColumnDefinition Width="119*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Button Content="Добавить читателя" Grid.Column="2" Grid.Row="0" Margin="6,5,5,5"/>
        <Button Content="Выдача книги" Grid.Column="3" Grid.Row="0" Margin="5,5,6,5"/>
        <Button Content="Просмотр истории" Grid.Column="4" Grid.Row="0" Margin="4,5,5,5"/>
        <TextBox  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="6,5,6,5"/>
        <Button Content="поиск" Grid.Row="1"  Grid.Column="5" Margin="4,5,5,5"/>
        <Button Content="Создать отчет" Grid.Column="5" />
        <StackPanel Background="WhiteSmoke" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2">
            <ListView  Grid.RowSpan="3">
                <ListView.ItemTemplate>
                    <DataTemplate>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>

        <ListView Margin="8" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4">
            <ListView.ItemTemplate >
                <DataTemplate>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>


</Window>
